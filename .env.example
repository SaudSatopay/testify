# ------------------------------------------------------------------
# Testify — frontend environment variables
# Copy this file to `.env` and fill the values from your Supabase
# project (Dashboard → Project Settings → API).
#
# ONLY public/publishable values belong here. Secret keys (service
# role, OpenAI, Anthropic, Resend, …) are configured as Supabase Edge
# Function secrets — never in this file, never in the frontend.
# ------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
